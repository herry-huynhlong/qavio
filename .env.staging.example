# Template only. No SMTP/production flags are implicitly approved.
QAVIO_DEPLOYMENT_ENV=staging
DATABASE_URL=postgresql://qavio_app:REPLACE_RANDOM@qavio-postgres:5432/qavio_staging?connection_limit=3&connect_timeout=3
APP_ORIGIN=
SITE_URL=
SITE_INDEXING_ENABLED=false
QAVIO_TOKEN_SECRET=
QAVIO_TRUSTED_PROXY_SECRET=
QAVIO_ADMIN_ENABLED=true
QAVIO_CMS_ENABLED=true
QAVIO_MEDIA_ROOT=/var/lib/qavio/media
QAVIO_OPS_ROOT=/var/lib/qavio/ops
QAVIO_MEDIA_MAX_BYTES=1073741824
QAVIO_PUBLIC_FORMS_ENABLED=false
QAVIO_DATA_POLICY_APPROVED=false
QAVIO_ADMIN_DATA_REQUESTS_APPROVED=false
QAVIO_LEGAL_PUBLICATION_APPROVED=false
EMAIL_PROVIDER=disabled
EMAIL_FROM=
LEAD_NOTIFICATION_EMAIL=
LEAD_RECEIPT_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Fill only after owner approval. Do not put approval flags in permanent runtime env.
QAVIO_SMTP_TEST_TO=
QAVIO_DKIM_SELECTOR=
