# Website: keep indexing off until owner approval.
SITE_URL=https://qavio.longh.org
SITE_INDEXING_ENABLED=false
QUANPILOT_PUBLIC_URL=
APP_ORIGIN=http://127.0.0.1:3100
# Local only. Never copy a Restaurant URL. URL-encode credentials.
DATABASE_URL=postgresql://qavio_local:CHANGE_ME@127.0.0.1:55432/qavio_dev
QAVIO_TEST_DATABASE_URL=postgresql://qavio_local:CHANGE_ME@127.0.0.1:55432/qavio_test
QAVIO_DEV_DB_PASSWORD=CHANGE_ME
QAVIO_DEPLOYMENT_ENV=development
# Closed by default. Production also requires explicit policy approval.
QAVIO_PUBLIC_FORMS_ENABLED=false
QAVIO_DATA_POLICY_APPROVED=false
# Generate a unique secret of at least 32 random bytes; share it with the worker.
QAVIO_TOKEN_SECRET=
# Trusted reverse proxy must OVERWRITE both headers; never expose its secret.
QAVIO_TRUSTED_PROXY_SECRET=
EMAIL_PROVIDER=disabled
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
LEAD_NOTIFICATION_EMAIL=
LEAD_RECEIPT_ENABLED=false
# Existing web container settings; Phase C does not deploy this configuration.
QAVIO_HTTP_PORT=3100
QAVIO_IMAGE_TAG=local
QAVIO_MEMORY_LIMIT=256m
QAVIO_MEMORY_SWAP_LIMIT=512m
QAVIO_CPUS=0.50
