# Local preview only; set the verified public domain before staging/production.
SITE_URL=http://localhost:3100
# Keep disabled until content/SEO approval; Next metadata and headers are built
# with this setting, so changing it requires a new production build.
SITE_INDEXING_ENABLED=false
# Leave empty until the owner confirms the product's official public URL.
QUANPILOT_PUBLIC_URL=
# Docker Compose host port; only published on loopback for the host reverse proxy.
QAVIO_HTTP_PORT=3100
QAVIO_IMAGE_TAG=local
QAVIO_MEMORY_LIMIT=256m
QAVIO_MEMORY_SWAP_LIMIT=512m
QAVIO_CPUS=0.50
# Independent PostgreSQL, authentication and email will be configured in phases C–E.
# Do not copy credentials or DATABASE_URL from Restaurant.
