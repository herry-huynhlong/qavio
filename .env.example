# Website: keep indexing off until owner approval.
SITE_URL=https://qavio.site
SITE_INDEXING_ENABLED=false
QUANPILOT_PUBLIC_URL=
APP_ORIGIN=http://127.0.0.1:3100
# Production CMS: https://qavio.site; blank uses APP_ORIGIN for local tests.
QAVIO_ADMIN_ORIGIN=
# Local only. Never copy a Restaurant URL. URL-encode credentials.
DATABASE_URL=postgresql://qavio_local:CHANGE_ME@127.0.0.1:55432/qavio_dev
QAVIO_TEST_DATABASE_URL=postgresql://qavio_local:CHANGE_ME@127.0.0.1:55432/qavio_test
QAVIO_DEV_DB_PASSWORD=CHANGE_ME
QAVIO_DEPLOYMENT_ENV=development
# Closed by default. Production also requires explicit policy approval.
QAVIO_PUBLIC_FORMS_ENABLED=false
QAVIO_DATA_POLICY_APPROVED=false
# Generate a unique secret of at least 32 random bytes; share it with the worker.
QAVIO_TOKEN_SECRET=
# Trusted reverse proxy must OVERWRITE both headers; never expose its secret.
QAVIO_TRUSTED_PROXY_SECRET=
EMAIL_PROVIDER=disabled
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
LEAD_NOTIFICATION_EMAIL=
LEAD_RECEIPT_ENABLED=false
# Existing web container settings; Phase C does not deploy this configuration.
QAVIO_HTTP_PORT=3100
QAVIO_IMAGE_TAG=local
QAVIO_MEMORY_LIMIT=256m
QAVIO_MEMORY_SWAP_LIMIT=512m
QAVIO_CPUS=0.50

# D: local/admin access; do not enable on production without release approval.
QAVIO_ADMIN_ENABLED=false
QAVIO_CMS_ENABLED=false
QAVIO_ADMIN_DATA_REQUESTS_APPROVED=false
QAVIO_LEGAL_PUBLICATION_APPROVED=false
# Required persistent private directory for media when D is approved for production.
QAVIO_MEDIA_ROOT=

# E operations: private persistent directory in deployed containers.
QAVIO_OPS_ROOT=
QAVIO_MEDIA_MAX_BYTES=1073741824
# Backup encryption public key only on server; private key held separately.
QAVIO_BACKUP_PUBLIC_KEY_FILE=
QAVIO_BACKUP_FILE=

# CONTACT/DEMO only; does not enable QUOTE/newsletter or legal approval.
QAVIO_CONSULTATION_FORMS_ENABLED=false

# Trial integration remains disabled until isolated staging + Google OAuth are verified.
QAVIO_TRIAL_ENABLED=false
QUANPILOT_TRIAL_API_ORIGIN=
QUANPILOT_TRIAL_PUBLIC_ORIGIN=
QUANPILOT_QAVIO_TRIAL_SECRET=
